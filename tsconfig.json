{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    // Node runs these files directly by stripping the types, so anything that
    // would need real emit (enum, namespace, parameter properties, decorators)
    // has to fail here rather than at runtime.
    "erasableSyntaxOnly": true
  },
  "include": ["src", "test", "tools"]
}
