{
  "name": "consolepro",
  "version": "0.0.0",
  "description": "Rich, styled content in the devtools console, via Custom Formatters.",
  "keywords": [
    "console",
    "console-log",
    "logging",
    "debugging",
    "devtools",
    "chrome-devtools",
    "styled-console",
    "console-formatting",
    "pretty-print",
    "html",
    "css"
  ],
  "author": "António Afonso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aadsm/consolepro.git"
  },
  "homepage": "https://github.com/aadsm/consolepro#readme",
  "bugs": {
    "url": "https://github.com/aadsm/consolepro/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/consolepro.esm.js"
    }
  },
  "main": "./dist/consolepro.esm.js",
  "module": "./dist/consolepro.esm.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/consolepro.js",
  "jsdelivr": "./dist/consolepro.js",
  "sideEffects": false,
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "node tools/build.ts",
    "version": "node tools/sync-readme-version.ts && git add README.md",
    "prepublishOnly": "npm run check && npm test && npm run build",
    "screenshots": "node tools/screenshots.ts"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "puppeteer": "25.10.0",
    "typescript": "^5.6.0"
  }
}
